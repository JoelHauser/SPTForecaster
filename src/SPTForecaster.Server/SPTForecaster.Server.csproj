<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SPTForecaster.Server</RootNamespace>
    <AssemblyName>SPTForecaster.Server</AssemblyName>

    <!-- Must match ModMetadata.Version and the client's PluginVersion. -->
    <Version>0.1.0</Version>

    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

    <!-- The SPT install root; the server's assemblies live in SPT_Runtime under it. -->
    <SPTPath Condition="'$(SPTPath)' == ''">H:\SPT4.1.X</SPTPath>
    <SPTServer>$(SPTPath)\SPT_Runtime</SPTServer>
  </PropertyGroup>

  <Target Name="ValidateSPTPath" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(SPTServer)\SPTarkov.Server.Core.dll')"
           Text="SPTPath ('$(SPTPath)') has no SPT_Runtime\SPTarkov.Server.Core.dll." />
  </Target>

  <ItemGroup>
    <Reference Include="SPTarkov.Server.Core"><HintPath>$(SPTServer)\SPTarkov.Server.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.DI"><HintPath>$(SPTServer)\SPTarkov.DI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.Common"><HintPath>$(SPTServer)\SPTarkov.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SemanticVersioning"><HintPath>$(SPTServer)\SemanticVersioning.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
